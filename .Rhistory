reticulate::repl_python()
library(plotly)
# Criando dados de exemplo
set.seed(123)
df <- data.frame(x = rnorm(300, 50, 20), y = rnorm(300, 50, 20))
# Criando os gráficos separadamente
scatter <- plot_ly(df, x = ~x, y = ~y, type = "scatter", mode = "markers",
marker = list(color = 'blue', opacity = 0.5))
box_x <- plot_ly(df, x = ~x, type = "box", boxpoints = "all", jitter = 0.3, marker = list(color = 'blue'))
box_y <- plot_ly(df, y = ~y, type = "box", boxpoints = "all", jitter = 0.3, marker = list(color = 'blue'))
# Combinando os gráficos com subplot
plotly::subplot(
plotly::layout(box_x, xaxis = list(title = ""), showlegend = FALSE),
scatter,
plotly::layout(box_y, yaxis = list(title = ""), showlegend = FALSE),
nrows = 2, widths = c(0.8, 0.2), heights = c(0.2, 0.8),
shareX = TRUE, shareY = TRUE
)
plot_ly(data = dt,
x = ~Defense,
y = ~Attack,
symbol = ~Legendary,
symbols = c('circle','x'),
text = ~paste(Name))
