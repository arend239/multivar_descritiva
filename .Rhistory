Q = matrix(c(-1,1,0,0,0,
1,-2,1,0,0,
0,2,-3,1,0,
0,0,2,-3,1,
0,0,0,4,-4), ncol = 5, byrow = TRUE)
Q
# Questão 2: Matriz de saltos
P = t(sapply(1:ncol(Q), function(i) -Q[i,]/Q[i,i]))
diag(P) = 0
P
# Questão 3: distribuição estacionária da matriz de saltos
solve_stationary <- function(Q) {
n <- nrow(Q)
A <- rbind(t(Q), rep(1, n)) # Adiciona a restrição soma(π) = 1
b <- c(rep(0, n), 1)        # Vetor de soluções
pi <- solve(t(A) %*% A, t(A) %*% b) # Resolve o sistema linear
return(pi)
}
pi <- solve_stationary(Q)
pi
# Questão 4: holding time
diag_Q = diag(Q)
holding_times = 1 / abs(diag_Q)
holding_times
# Questão 6: tempo médio que o estoque fica vazio
1/pi[1]
