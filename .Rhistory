# Questão 3: distribuição estacionária da matriz de saltos
solve_stationary <- function(Q) {
n <- nrow(Q)
A <- rbind(t(Q), rep(1, n)) # Adiciona a restrição soma(π) = 1
b <- c(rep(0, n), 1)        # Vetor de soluções
pi <- solve(t(A) %*% A, t(A) %*% b) # Resolve o sistema linear
return(pi)
}
